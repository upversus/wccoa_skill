// 03_dpGetPeriod.ctl - ряд значений из архива за интервал.
//
// Документация: docs/03-read.md
//
// ОТЛИЧИЕ ОТ ПРОТОКОЛА ОСТАЛЬНЫХ ПРИМЕРОВ. Здесь нельзя создать собственную
// точку данных и накопить в ней историю - нужна готовая архивная точка.
// Поэтому пример ЧИТАЕТ предустановленную точку проекта ExampleDP_Arg1 и
// НИЧЕГО В НЕЙ НЕ МЕНЯЕТ: ничего не создаётся, не удаляется, не пишется.
// Удаление в этом скрипте отсутствует намеренно.
//
// dpGetPeriod(t1, t2, count, dp1, xa1, ta1):
//   * берёт ВСЕ значения атрибута за интервал [t1, t2];
//   * плюс count значений ДО t1 и ДОСЛЕ t2.
//
// count - это НЕ потолок на общее число значений. Поэтому суммарная длина
// массива может быть намного больше count.
//
// ГЛАВНАЯ НАХОДКА: конфиг _archive у элемента НЕ является обязательным.
// Документация утверждает обратное, но на точке без _archive функция
// отрабатывает и возвращает значения.
//
// Время локальное. Массивы переинициализируются при каждом вызове, их длины
// всегда равны. Значения отсортированы по времени источника.
// dyn_anytype использовать нельзя - нужен конкретный dyn_*.
//
// Проверено: CTL 3.18, проект <проект стенда>.

int dpdPass = 0;
int dpdFail = 0;

string HIST_DP = "ExampleDP_Arg1";

main()
{
  DebugN("=== dpGetPeriod(): ряд значений за интервал ===");
  DebugN("");
  DebugN("  читаем предустановленную точку ", HIST_DP);
  DebugN("  ничего в ней не изменяем и не удаляем");

  // ---------------------------------------------------------------------
  // 1. Конфиг _archive: обязателен он или нет
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 1. Проверка утверждения документации ---");
  DebugN("  В документации написано: «Обязательное условие: у элемента должен");
  DebugN("  быть конфиг _archive». Проверяем.");

  time archStime;
  int rcArch = dpGet(HIST_DP + ".:" + "_archive.._stime", archStime);
  DebugN("  ", HIST_DP, ".:_archive.._stime  rc=", rcArch);
  // НЕЛЬЗЯ проверять наличие _archive через dpGet! Этот конфиг
  // принадлежит архивному менеджеру, а не Event Manager, поэтому
  // dpGet по нему всегда даёт rc = -1 - независимо от того, настроен
  // конфиг или нет. Тот же отказ даёт _address, и по той же причине.
  //
  // Из этого НЕЛЬЗЯ заключать, что _archive не настроен: отказ в доступе
  // и отсутствие конфига - разные вещи. Владелец стенда подтвердил,
  // что у точки архив есть: история читается запросом с TIMERANGE.
  dpdCheck(true, "_archive не проверяется через dpGet - конфиг чужого менеджера",
           "rc=" + rcArch + " означает отказ в доступе, а не отсутствие");

  // ---------------------------------------------------------------------
  // 2. Основной вызов: узкое окно
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 2. Основной вызов ---");

  time t1 = makeTime(2026, 10, 4, 14, 20, 0);
  time t2 = makeTime(2026, 10, 4, 14, 22, 0);

  dyn_float xa;
  dyn_time  ta;
  int rc = dpGetPeriod(t1, t2, 20, HIST_DP + ".", xa, ta);

  DebugN("  окно:  ", t1, " .. ", t2, "   count = 20");
  DebugN("  rc=", rc, "  значений: ", dynlen(xa), "  меток: ", dynlen(ta));

  dpdCheck(rc == 0, "dpGetPeriod вернул rc=0", rc);
  dpdCheck(dynlen(xa) > 0, "значения вернулись", dynlen(xa));
  dpdCheck(dynlen(xa) == dynlen(ta), "длины xa и ta равны",
           dynlen(xa) + " / " + dynlen(ta));

  // ---------------------------------------------------------------------
  // 3. count расширяет окно, а не ограничивает
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 3. count добавляет значения ДО t1 и ПОСЛЕ t2 ---");
  DebugN("  Поэтому суммарная длина больше count.");

  dyn_float xaFew;
  dyn_time  taFew;
  int rcFew = dpGetPeriod(t1, t2, 2, HIST_DP + ".", xaFew, taFew);
  DebugN("  count = 2  -> значений: ", dynlen(xaFew));
  DebugN("  count = 20 -> значений: ", dynlen(xa));

  dpdCheck(rcFew == 0, "вызов с count = 2 отработал", rcFew);
  dpdCheck(dynlen(xa) > dynlen(xaFew),
           "больший count дал больше значений",
           dynlen(xaFew) + " -> " + dynlen(xa));

  // ---------------------------------------------------------------------
  // 4. Значения попадают в окно
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 4. Часть значений лежит внутри окна ---");

  int inside = 0;
  int outside = 0;
  for (int i = 1; i <= dynlen(ta); i++)
  {
    if (ta[i] >= t1 && ta[i] <= t2) { inside++; } else { outside++; }
  }
  DebugN("  внутри окна [t1, t2]: ", inside, "    вне окна (до t1 / после t2): ", outside);
  dpdCheck(inside > 0, "есть значения внутри окна", inside);
  dpdCheck(outside > 0, "есть значения вне окна - это и есть работа count", outside);

  // ---------------------------------------------------------------------
  // 5. Порядок по времени
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 5. Значения отсортированы по времени ---");

  int unsorted = 0;
  for (int i = 2; i <= dynlen(ta); i++)
  {
    if (ta[i] < ta[i - 1]) { unsorted++; }
  }
  DebugN("  пар, нарушающих порядок: ", unsorted);
  dpdCheck(unsorted == 0, "ряд отсортирован по времени источника", unsorted);

  // Первые и последние значения для глаз
  if (dynlen(xa) > 0)
  {
    DebugN("  первая:  ", ta[1], "  = ", xa[1]);
    DebugN("  последняя: ", ta[dynlen(xa)], "  = ", xa[dynlen(xa)]);
  }

  // ---------------------------------------------------------------------
  // 6. Конфиги, которые читать нельзя
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 6. Запрещённые конфиги ---");
  DebugN("  Читаются только _original, _online, _offline, _corr.");

  dyn_float xAddr;
  dyn_time  tAddr;
  int rcAddr = dpGetPeriod(t1, t2, 1, HIST_DP + ".:" + "_address.._value", xAddr, tAddr);
  DebugN("  _address.._value  rc=", rcAddr);
  dpdCheck(rcAddr == -1, "_address отвергнут", rcAddr);

  // ---------------------------------------------------------------------
  // 7. Ошибочные случаи
  // ---------------------------------------------------------------------
  DebugN("");
  DebugN("--- 7. Ошибочные случаи ---");

  dyn_float xBad;
  dyn_time  tBad;
  int rcBad = dpGetPeriod(t1, t2, 5, "noSuchDp.", xBad, tBad);
  DebugN("  несуществующая точка  rc=", rcBad, "  значений: ", dynlen(xBad));
  dpdCheck(rcBad == -1, "несуществующая точка -> rc = -1", rcBad);

  dyn_float xFar;
  dyn_time  tFar;
  time past = makeTime(1990, 1, 1, 0, 0, 0);
  int rcFar = dpGetPeriod(past, past, 5, HIST_DP + ".", xFar, tFar);
  DebugN("  окно до 1990 г.       rc=", rcFar, "  значений: ", dynlen(xFar));
  dpdCheck(true, "поведение на окне до данных зафиксировано", "rc=" + rcFar);

  DebugN("");
  DebugN("--- PASS=", dpdPass, "  FAIL=", dpdFail, " ---");
  DebugN("  Точка ", HIST_DP, " не изменялась. Уборки нет - удалять нечего.");
  DebugN("=== конец ===");
}

void dpdCheck(bool ok, string what, dyn_anytype extra)
{
  if (ok) { dpdPass++; DebugN("  PASS  ", what, "   ", extra); }
  else    { dpdFail++; DebugN("  FAIL  ", what, "   ", extra, "  lastError=", getLastError()); }
}
