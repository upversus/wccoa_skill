// 01_dpConnect.ctl - dpConnect(): подписка на изменение значения.
//
// Документация: docs/05-subscribe.md#dpconnect
// Проверено: CTL 3.18, проект <проект стенда>
//
// ПРОТОКОЛ ПРОВЕРКИ. Нужны ДВА процесса: подписчик живёт и ждёт события,
// значения ставит отдельный служебный скрипт _trigger_dpConnect.ctl. Оба
// одновременно, в разных окнах консоли.
//
//   1) подписчик (остаётся висеть):
//        .\run-ctl.ps1 -Script .\05-subscribe\01_dpConnect.ctl -LongRunning -Num 200
//   2) триггер (второе окно):
//        .\run-ctl.ps1 -Script .\05-subscribe\_trigger_dpConnect.ctl -Num 201
//   3) прочитать stdout подписчика (путь печатает run-ctl.ps1) и остановить его:
//        Stop-Process -Id <PID> -Force
//
// Ожидаемая сводка: --- PASS= 11  FAIL= 0 ---
//
// СКРИПТ НЕ ЗАВЕРШАЕТСЯ САМ - это правильное поведение подписчика.
//
// ЧТО ЗДЕСЬ ГЛАВНОЕ.
//   * dpConnect() только регистрирует колбэк и сразу возвращается.
//   * Скрипт продолжает жить после main(), а колбэк вызывается на каждое
//     изменение подписанного DPE - в том числе когда значение ставит ДРУГОЙ
//     процесс. Именно этого не показывает разовый прогон.
//   * Второй параметр - answer. TRUE заставляет вызвать колбэк принудительно
//     уже на инициализации, с текущим значением DPE (регистрационный вызов).
//     Здесь стоит FALSE: пример показывает только реакцию на реальные
//     изменения, поэтому вызовов ровно столько, сколько записей пришло.
//   * Писать надо в _original.._value. dpSet() в _online.._value возвращает
//     rc=0, но значение точки не меняется, и подписка молчит (проверено).
//   * -Num: номер менеджера скрипта. 0 - автовыбор номера Data Manager'ом.
//     У двух одновременных скриптов номера обязаны различаться; у драйверов
//     своё пространство номеров, с ними скрипты не конфликтуют.

int dpdPass = 0;
int dpdFail = 0;

string DPT = "sub_t";
string DP  = "dpdemo_sub";

// Заглушка: сюда колбэк кладёт пришедшее значение. Префикс val_ - соглашение
// примеров: по имени видно, что значение пришло извне, а не вычислено здесь.
float val_fNewValue = 0.0;

int  nChanges = 0;        // сколько записей триггера уже обработано

// Четыре значения, которые ставит _trigger_dpConnect.ctl.
float E1 = 22.3;
float E2 = 47.5;
float E3 = -5.25;
float E4 = 100.0;

main()
{
  DebugN("=== dpConnect(): подписка на изменение значения ===");
  DebugN("  подписчик не завершится сам; значения ставит _trigger_dpConnect.ctl");

  makeType();
  makeDp();

  // -------------------------------------------------------------------
  // 1. Регистрация подписки
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 1. dpConnect() ---");

  int rc = dpConnect("onValue", FALSE, DP + ".value:_online.._value");
  dpdCheck(rc == 0, "dpConnect вернул 0", rc);
  DebugN("  lastError после регистрации: ", getLastError());

  DebugN("  дальше скрипт ждёт событий; сводка появится после 4-й записи триггера");
}

// ---------------------------------------------------------------------------
// Колбэк. Сигнатура повторяет набор адресов подписки: сначала имя DPE,
// затем значение. Имя приходит с системой: System1:dpdemo_sub.value:...
// ---------------------------------------------------------------------------
void onValue(string dp, float fNewValue)
{
  if (nChanges >= 4)
  {
    dpdCheck(FALSE, "лишний вызов колбэка", fNewValue);
    return;
  }

  dpdCheck(strpos(dp, DP + ".value") >= 0, "имя DPE содержит точку подписки", dp);
  dpdCheck(closeEnough(fNewValue, expectedAt(nChanges + 1)),
           "значение совпало с записанным триггером", fNewValue);

  nChanges++;
  val_fNewValue = fNewValue;

  if (nChanges == 4)
  {
    DebugN("  значение в заглушке val_fNewValue = ", val_fNewValue);
    dpdSummary();
    DebugN("  сводка напечатана; подписка продолжает работать, скрипт жив");
  }
}

// ---------------------------------------------------------------------------
// Ожидаемое значение по номеру записи. Отдельная функция вместо массива:
// в примерах репозитория нигде не используется литерал массива, а dyn_float
// с индексацией читается хуже в демонстрационном коде.
// ---------------------------------------------------------------------------
float expectedAt(int i)
{
  if (i == 1) { return E1; }
  if (i == 2) { return E2; }
  if (i == 3) { return E3; }
  return E4;
}

// Сравнение float только с допуском: 22.3 в FLOAT может лечь как 22.299999...
bool closeEnough(float a, float b)
{
  float d = a - b;
  if (d < 0) { d = -d; }
  return d < 0.001;
}

// ---------------------------------------------------------------------------
// Своя точка данных и свой тип: пример не зависит от демо-точек проекта.
// ---------------------------------------------------------------------------
void makeType()
{
  dyn_dyn_string pn;
  dyn_dyn_int pt;
  if (dpTypeGet(DPT, pn, pt) == 0)
  {
    dpdCheck(TRUE, "тип уже существует", DPT);
    return;
  }

  dyn_dyn_string n;
  dyn_dyn_int t;
  n[1] = makeDynString(DPT);          t[1] = makeDynInt(DPEL_STRUCT);
  n[2] = makeDynString("", "value");  t[2] = makeDynInt(0, DPEL_FLOAT);
  dpdCheck(dpTypeCreate(n, t) == 0, "тип создан", DPT);
}

void makeDp()
{
  // Удаляем точку от прошлого прогона: у новой точки значение 0.0, и
  // регистрационный колбэк answer=TRUE несёт именно его. Если оставить точку,
  // первый колбэк принесёт значение, записанное в прошлый раз.
  if (dpExists(DP))
  {
    int rcDel = dpDelete(DP);
    DebugN("  teardown: dpDelete(", DP, ") rc=", rcDel);
  }
  dpdCheck(dpCreate(DP, DPT) == 0, "точка данных создана", DP);
}

// ---------------------------------------------------------------------------
// Самодостаточный блок проверки - копия из examples/_lib.ctl: демо-скрипты
// не подключают библиотек, чтобы куски кода работали в скилле без зависимостей.
// ---------------------------------------------------------------------------
void dpdCheck(bool ok, string what, dyn_anytype extra)
{
  if (ok) { dpdPass++; DebugN("  PASS  ", what, "   ", extra); }
  else    { dpdFail++; DebugN("  FAIL  ", what, "   ", extra, "  lastError=", getLastError()); }
}

void dpdSummary()
{
  DebugN("--- PASS=", dpdPass, "  FAIL=", dpdFail, " ---");
}
