// 03_groupDelete.ctl - groupDelete(): удаление группы точек данных.
//
// Документация: docs/07-copy.md
//
// ПРОТОКОЛ ПРОВЕРКИ. Группы создаются и удаляются внутри скрипта, имена
// делаются уникальными. Предустановленные точки и чужие группы не затрагиваются.
//
// ВАЖНО ПРО ИМПОРТ. groupDelete() - не функция базовой библиотеки DLL, а
// обычная функция на CTL из библиотеки dpGroups.ctl. Без директивы
//     #uses "dpGroups.ctl"
// вызов не компилируется: SEVERE, 72, Function not defined.
//
// ВАЖНО ПРО iError. Как и у groupCreate(), код ошибки присваивается ТОЛЬКО
// в ветках ошибки - при успехе iError не пишется. Перед вызовом переменную
// нужно обнулять самому, иначе "успех" не отличить от мусора.
//
// Проверено: CTL 3.18, проект <проект стенда>.

#uses "dpGroups.ctl"

int dpdPass = 0;
int dpdFail = 0;

string GRP = "dpdemo_del_grp";

main()
{
  DebugN("=== groupDelete(): удаление группы точек данных ===");
  DebugN("  библиотека dpGroups.ctl подключена, функция доступна");

  // -------------------------------------------------------------------
  // 1. Успешное удаление
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 1. Создали группу и удалили ---");

  string gp = "";
  int eCreate = 0;
  groupCreate(GRP, FALSE, gp, FALSE, eCreate);
  DebugN("  создали группу: iError=", eCreate, "  newGroup='", gp, "'");
  dpdCheck(eCreate == 0 && gp != "", "группа создана для проверки удаления", gp);
  dpdCheck(dpExists(gp), "точка данных группы существует до удаления", dpExists(gp));

  int eDel = -999;         // мусор на входе: убеждаемся, что код пишется
  groupDelete(GRP, eDel);
  DebugN("  groupDelete(\"" + GRP + "\"): iError=", eDel,
         "  текст: '", groupGetErrorText(eDel), "'");
  dpdCheck(eDel == 0, "удаление вернуло iError = 0", eDel);

  for (int i = 1; i <= 30; i++)
  {
    if (!dpExists(gp)) { break; }
    delay(1);
  }
  DebugN("  dpExists(\"" + gp + "\") после удаления = ", dpExists(gp));
  dpdCheck(!dpExists(gp), "точка данных группы удалена", dpExists(gp));

  // Имя группы больше не находится.
  DebugN("  groupNameToDpName(\"" + GRP + "\") = '", groupNameToDpName(GRP), "'");
  dpdCheck(groupNameToDpName(GRP) == "",
           "удалённая группа больше не находится по имени", "пусто");

  // -------------------------------------------------------------------
  // 2. Несуществующая группа
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 2. Несуществующая группа ---");

  int e2 = 0;
  groupDelete(GRP, e2);
  DebugN("  iError=", e2, "  текст: '", groupGetErrorText(e2), "'");
  DebugN("  Документация обещает -2 (имя не найдено).");
  dpdCheck(e2 == -2, "несуществующая группа -> iError = -2", e2);

  // -------------------------------------------------------------------
  // 3. Пустое имя
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 3. Пустое имя группы ---");

  int e3 = 0;
  groupDelete("", e3);
  DebugN("  iError=", e3, "  текст: '", groupGetErrorText(e3), "'");
  dpdCheck(e3 == -2, "пустое имя -> iError = -2", e3);

  // -------------------------------------------------------------------
  // 4. Асимметрия с groupCreate() по iError
  // -------------------------------------------------------------------
  // ИЗМЕРЕНО: в отличие от groupCreate(), ЗДЕСЬ iError присваивается при
  // успехе - мусор на входе был заменён нулём. То есть у двух функций из
  // одной библиотеки разное поведение, и полагаться на это нельзя:
  // обнулять перед вызовом нужно обе.
  DebugN("");
  DebugN("--- 4. Асимметрия iError с groupCreate() ---");

  string gp2 = "";
  int eC2 = 0;
  groupCreate(GRP + "_2", FALSE, gp2, FALSE, eC2);

  int dirty = 4242;
  groupDelete(GRP + "_2", dirty);
  DebugN("  перед вызовом iError = 4242, после УСПЕШНОГО удаления: ", dirty);
  DebugN("  groupCreate() в этом месте iError НЕ пишет, groupDelete() пишет 0.");
  dpdCheck(dirty == 0,
           "groupDelete обнуляет iError при успехе - в отличие от groupCreate", dirty);

  // -------------------------------------------------------------------
  // 5. Группа как фильтр
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 5. Код -8: группа используется как фильтр ---");
  DebugN("  Проверку этого сценария в CTL нельзя выполнить корректно:");
  DebugN("  для неё нужна группа, назначенная фильтром в UI/GEDI. Код -8");
  DebugN("  документирован, но на стенде не воспроизведён - и это честная");
  DebugN("  граница, а не пропуск.");

  // -------------------------------------------------------------------
  // 6. Уборка
  // -------------------------------------------------------------------
  DebugN("");
  DebugN("--- 6. Уборка ---");

  int e6 = 0;
  groupDelete(GRP + "_2", e6);
  dpdCheck(e6 == -2, "повторных объектов не осталось", e6);

  DebugN("");
  DebugN("--- PASS=", dpdPass, "  FAIL=", dpdFail, " ---");
  DebugN("=== конец ===");
}

void dpdCheck(bool ok, string what, dyn_anytype extra)
{
  if (ok) { dpdPass++; DebugN("  PASS  ", what, "   ", extra); }
  else    { dpdFail++; DebugN("  FAIL  ", what, "   ", extra, "  lastError=", getLastError()); }
}